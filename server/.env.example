DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
CLINIC_TIME_ZONE=Asia/Manila
JSON_BODY_LIMIT=12mb

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Insurance decisions use the local plan simulation; no payer credentials are required.

SUPABASE_URL=
# Preferred server-only key; keep it out of client code and version control.
SUPABASE_SECRET_KEY=
# Legacy server-only key, retained for existing deployments.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BILL_BUCKET=patient-bills

# Enable only after MAIL_FROM uses a sender/domain verified in Resend.
EMAIL_FEATURES_ENABLED=false
MAIL_FROM=
RESEND_API_KEY=
